# PostgreSQL / existing project configuration stays in your real .env.

# n8n webhook that receives ConnectCare 360 engagement events
N8N_WEBHOOK_URL=https://SEU_N8N/webhook/connectcare-engagement

# Optional per-channel webhooks. If empty, N8N_WEBHOOK_URL is used.
N8N_WEBHOOK_URL_WHATSAPP=
N8N_WEBHOOK_URL_EMAIL=
N8N_WEBHOOK_URL_SMS=

# Optional shared secret sent as X-ConnectCare-Secret
N8N_WEBHOOK_SECRET=

# Engagement AI (optional; fallback message is used without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
